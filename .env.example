# ---------- Shopify (secrets: never commit .env) ----------
SHOPIFY_STORE_DOMAIN=va9wah-fx.myshopify.com
SHOPIFY_API_VERSION=2026-07
# Preferred: Dev Dashboard app installed on this store (client-credentials grant)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternative: an existing offline Admin API access token (shpat_...)
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Optional: pin the inventory location (defaults to the first active one, "Sector 40")
SHOPIFY_LOCATION_ID=

# ---------- Sync behaviour (all can also be changed from the dashboard) ----------
DRY_RUN=true
SYNC_LIMIT=0
SYNC_INTERVAL_HOURS=5
DEFAULT_ETA=7–14 Days
NEW_PRODUCT_STATUS=DRAFT
PRODUCT_MISSING_CONFIRMATION_SCANS=2
MISSING_ACTION=archive
# Must be set to true by the store owner only after confirming permission to reuse ON images/descriptions
CONTENT_REUSE_CONFIRMED=false
ADOPT_EXISTING_PRODUCTS=false

# ---------- Pricing ----------
SOURCE_CURRENCY=USD
TARGET_CURRENCY=INR
# INR per 1 USD. 0 = not configured (live sync refuses to run)
EXCHANGE_RATE=0
EXCHANGE_RATE_BUFFER_PCT=0
MARKUP_TYPE=percentage
MARKUP_VALUE=0
MIN_PROFIT=0
# none | nearest_10 | nearest_100 | ceil_100 | ceil_500 | ceil_1000 | end_99 | end_999
ROUNDING_RULE=none
# source_list = convert ON's original price the same way and show it as compare-at; none = no compare-at
COMPARE_AT_MODE=source_list

# ---------- Catalog mapping ----------
VENDOR=On Running
PRODUCT_TYPE=Sneakers
BASE_TAGS=On,On Running,ETA,DS,Sneakers,On Last Season,on-sync
TITLE_TEMPLATE=On Running {model} - {color} ({gender})
SIZE_OPTION_NAME=Size
# Storefront sizes: UK converts ON US sizes (men/unisex UK = US - 0.5, women UK = US - 2); kids stay US
SIZE_SYSTEM=UK
MEN_US_TO_UK_OFFSET=0.5
WOMEN_US_TO_UK_OFFSET=2

# ---------- Politeness ----------
REQUEST_DELAY_MS=2500
SOURCE_CONCURRENCY=1
DASHBOARD_PORT=3100

# ---------- Tory Burch (toryburch.com/en-us, USD) -> Full Size Run (node src/toryburch/cli.ts) ----------
# FSR is an official / authorized Tory Burch importer for India, with permission to download Tory Burch product images,
# upload them to Shopify and use Tory Burch descriptions / specifications (stated by the store owner 2026-09-26).
# Tory Burch importer ONLY - no other brand reads it. It does NOT authorise bypassing any technical access control.
# Watches / smartwatches / watch bands / Apple Watch bands are ALWAYS excluded in code (not configurable).
# Every setting also accepts TORY_BURCH_<KEY>; `node src/toryburch/cli.ts set KEY VALUE` overrides.
TORY_BURCH_AUTHORIZED_IMPORTER=true
TORY_BURCH_ENABLED=true
TORY_BURCH_SYNC_INTERVAL_HOURS=5
TORY_BURCH_ETA="15–20 Days"
TORY_BURCH_DRY_RUN=false
USD_INR_RATE_MAX_AGE_HOURS=24
TORY_BURCH_FX_PROVIDER=open.er-api.com
# kg upper bound : ₹ shipping; unknown weight -> fallback (toryburch.com publishes no weights)
TORY_BURCH_WEIGHT_BANDS=0.5:1000,1:1500,2:2500,3:3500,5:4250,+:5000
TORY_BURCH_WEIGHT_SURCHARGE_FALLBACK_INR=2500
# landed-cost upper bound ₹ : profit ₹
TORY_BURCH_PROFIT_BANDS=5000:1000,10000:1500,20000:2000,35000:3000,50000:3500,+:4000
TORY_BURCH_NEW_PRODUCT_STATUS=ACTIVE
TORY_BURCH_EXCLUDED_CATEGORIES=gift card,fragrance,home
TORY_BURCH_IMAGE_PRESET=pdp-2000x2000
TORY_BURCH_REQUEST_DELAY_MS=2000
